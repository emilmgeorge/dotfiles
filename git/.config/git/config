[color]
	ui = auto

[alias]
	stu = status -sb
	stat = status -uno
	pick = cherry-pick
	st = status -sb -uno
	diffc = diff --cached
	sln = ol --name-status
	root = rev-parse --show-toplevel
	flog = log --pretty=fuller --stat
	commend = commit --amend --no-edit
	last = log -1 --pretty=fuller --stat
	skip = update-index --skip-worktree
	unskip = update-index --no-skip-worktree
	svnco = "!~/.config/git/alias svnco"
	ol = "!~/.config/git/alias log_oneline"
	lu = "!~/.config/git/alias log_upstream"
	step = "!~/.config/git/alias step_to_ref"
	alias = "!~/.config/git/alias show_alias"
	skipped-ls = "!~/.config/git/alias list_skipped"
	branch-info = "!~/.config/git/alias branch_info"
	conflicts-ls = "!~/.config/git/alias list_conflicts"
	archive-branch = "!~/.config/git/alias archive_branch"
	sl = "!~/.config/git/alias log_oneline -$(( l=$(tput lines) / 4 - 2, l < 1 ? 1 : l ))"
	ml = "!~/.config/git/alias log_oneline -$(( l=$(tput lines) / 2 - 2, l < 2 ? 2 : l ))"
	ll = "!~/.config/git/alias log_oneline -$(( l=$(tput lines) - 2, l < 3 ? 3 : l ))"

[rebase]
	instructionFormat = (%an <%ae>) %s

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only --features=interactive

[add.interactive]
	# required for git 2.37.0
	useBuiltin = false

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = no

[delta]
	features = decorations
	line-numbers = true
	navigate = true
	light = false
[delta "interactive"]
	keep-plus-minus-markers = false
[delta "decorations"]
	commit-decoration-style = yellow ol ul
	commit-style = raw
	file-style = red
	file-decoration-style = red box

[include]
	path = local/main
