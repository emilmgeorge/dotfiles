From b3776c179d81ff7da793e0bd7d3cbb92b9e4a41c Mon Sep 17 00:00:00 2001
From: Emil M George <emilmgeorge@gmail.com>
Date: Mon, 26 May 2025 12:35:21 +0530
Subject: [PATCH 4/4] Add @tpm-source-await-at-end option

---
 scripts/source_plugins.sh | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/scripts/source_plugins.sh b/scripts/source_plugins.sh
index 71acf1c..52c1c2e 100755
--- a/scripts/source_plugins.sh
+++ b/scripts/source_plugins.sh
@@ -32,6 +32,7 @@ source_plugins() {
 	local groups group
 	local source_async
 	source_async=0
+	source_await_at_end=1
 	IFS="$GS" read -ra groups <<< "$declarations"
 	for group in "${groups[@]}"; do
 		if [[ "$group" == tpm-source-async"$US"* ]]; then
@@ -42,6 +43,11 @@ source_plugins() {
 		elif [[ "$group" == tpm-source-await"$US"* ]]; then
 			wait
 			continue
+		elif [[ "$group" == tpm-source-await-at-end"$US"* ]]; then
+			IFS="$US$RS$GS" read -r key value rest <<< "$group"
+			source_await_at_end=1
+			[[ "$value" == "off" ]] && source_await_at_end=0
+			continue
 		fi
 		[[ "$group" != plugin"$US"* ]] && continue
 		local records record
@@ -66,7 +72,9 @@ source_plugins() {
 			fi
 		fi
 	done
-	wait
+	if [[ "$source_await_at_end" != "0" ]]; then
+		wait
+	fi
 }
 
 main() {
