diff --git a/bindings/update_plugins b/bindings/update_plugins
index 28cc281..1374ace 100755
--- a/bindings/update_plugins
+++ b/bindings/update_plugins
@@ -16,15 +16,34 @@ source "$HELPERS_DIR/tmux_echo_functions.sh"
 source "$HELPERS_DIR/tmux_utils.sh"
 
 display_plugin_update_list() {
-	local plugins="$(tpm_plugins_list_helper)"
 	tmux_echo "Installed plugins:"
 	tmux_echo ""
 
-	for plugin in $plugins; do
-		# displaying only installed plugins
-		if plugin_already_installed "$plugin"; then
-			local plugin_name="$(plugin_name_helper "$plugin")"
-			tmux_echo "  $plugin_name"
+	local declarations
+	declarations=$(tpm_declarationss)
+	local groups group
+	IFS="$GS" read -ra groups <<< "$declarations"
+	for group in "${groups[@]}"; do
+		[[ "$group" != plugin"$US"* ]] && continue
+		local records record
+		IFS="$RS" read -ra records <<< "$group"
+		# Parse plugin and its required options
+		local plugin
+		for record in "${records[@]}"; do
+			local key value
+			IFS="$US" read -r key value <<< "$record"
+			if [ "$key" == "plugin" ]; then
+				IFS='#' read -ra plugin <<< "$value"
+			fi
+		done
+		# Use parsed plugin + options
+		if [ ${#plugin[@]} -gt 0 ]; then
+			plugin="${plugin[0]}"
+			# displaying only installed plugins
+			if plugin_already_installed "$plugin"; then
+				local plugin_name="$(plugin_name_helper "$plugin")"
+				tmux_echo "  $plugin_name"
+			fi
 		fi
 	done
 
diff --git a/scripts/clean_plugins.sh b/scripts/clean_plugins.sh
index a025524..411fc11 100755
--- a/scripts/clean_plugins.sh
+++ b/scripts/clean_plugins.sh
@@ -14,7 +14,29 @@ fi
 
 clean_plugins() {
 	local plugins plugin plugin_directory
-	plugins="$(tpm_plugins_list_helper)"
+	plugins=""
+	local declarations
+	declarations=$(tpm_declarations)
+	local groups group
+	IFS="$GS" read -ra groups <<< "$declarations"
+	for group in "${groups[@]}"; do
+		[[ "$group" != plugin"$US"* ]] && continue
+		local records record
+		IFS="$RS" read -ra records <<< "$group"
+		# Parse plugin and its required options
+		local plugin
+		for record in "${records[@]}"; do
+			local key value
+			IFS="$US" read -r key value <<< "$record"
+			if [ "$key" == "plugin" ]; then
+				IFS='#' read -ra plugin <<< "$value"
+			fi
+		done
+		# Use parsed plugin + options
+		if [ ${#plugin[@]} -gt 0 ]; then
+			plugins+="${plugin[0]}"$'\n'
+		fi
+	done
 
 	for plugin_directory in "$(tpm_path)"/*; do
 		[ -d "${plugin_directory}" ] || continue
diff --git a/scripts/helpers/plugin_functions.sh b/scripts/helpers/plugin_functions.sh
index f33d215..6515a5a 100644
--- a/scripts/helpers/plugin_functions.sh
+++ b/scripts/helpers/plugin_functions.sh
@@ -1,6 +1,10 @@
 # using @tpm_plugins is now deprecated in favor of using @plugin syntax
 tpm_plugins_variable_name="@tpm_plugins"
 
+US=$'\x1F'  # Unit Separator
+RS=$'\x1E'  # Record Separator
+GS=$'\x1D'  # Group Separator
+
 # manually expanding tilde char or `$HOME` variable.
 _manual_expansion() {
 	local path="$1"
@@ -68,13 +72,29 @@ tpm_path() {
 	echo "$_CACHED_TPM_PATH"
 }
 
-tpm_plugins_list_helper() {
+tpm_declarations() {
 	# lists plugins from @tpm_plugins option
-	echo "$(tmux start-server\; show-option -gqv "$tpm_plugins_variable_name")"
-
-	# read set -g @plugin "tmux-plugins/tmux-example-plugin" entries
-	_tmux_conf_contents "full" |
-		awk '/^[ \t]*set(-option)? +-g +@plugin/ { gsub(/'\''/,""); gsub(/'\"'/,""); print $4 }'
+	tmux start-server\; show-option -gqv "$tpm_plugins_variable_name" |
+		awk -v US="$US" -v GS="$GS" 'NF { printf "%splugin%s%s", GS, US, $1 }'
+
+	# read:
+	#	set -g @plugin "<plugin_name>" entries
+	#	set -g @plugin-<option> "<value>" entries
+	raw_defs=$(_tmux_conf_contents "full" |
+		sed -rn "s/^[[:space:]]*set(-option)?[[:space:]]+-g[[:space:]]+@(plugin|(plugin|tpm(-[^[:space:]]+)))/\2/p")
+
+	# Parse options
+	temp_prefix="_tpm_def_"
+	while read -r key value; do
+		if [[ "$key" == plugin-* ]]; then
+			printf "%s" "$RS"
+		else
+			printf "%s" "$GS"
+		fi
+		echo "$value" | xargs -I{} tmux set-option -g "@${temp_prefix}${key}" {}
+		value=$(tmux show-options -gv "@${temp_prefix}$key" 2>/dev/null) && printf "%s%s%s" "$key" "$US" "$value"
+		tmux set-option -gu "@${temp_prefix}${key}"
+	done <<< "$raw_defs"
 }
 
